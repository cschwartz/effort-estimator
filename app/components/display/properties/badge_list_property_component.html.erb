<div class="property-row">
  <dt class="text-sm font-medium text-base-content/70 block mb-1"><%= @label %></dt>
  <dd class="<%= dd_class %>">
    <% if content.present? %>
      <%= content %>
    <% else %>
      <div class="flex flex-wrap gap-2">
        <% @values.each do |value| %>
          <span class="<%= badge_classes %>">
            <%= value %>
          </span>
        <% end %>
      </div>
    <% end %>
  </dd>
</div>
