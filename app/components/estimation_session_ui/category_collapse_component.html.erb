<div class="collapse <%= collapse_state %> bg-base-200 mb-2"
     id="category-<%= category.title.parameterize %>">
  <input type="checkbox" <%= 'checked' if @is_active %> />
  <div class="collapse-title text-xl font-medium">
    <%= category.title %>
    <% if @is_active %>
      <%= render Display::BadgeComponent.new(
        label: "Active",
        variant: :success,
        css_class: "category-active-badge"
      ) %>
    <% end %>
    <%= render Display::BadgeComponent.new(
      label: @estimate.status.humanize,
      variant: status_badge_variant
    ) %>
  </div>
  <div class="collapse-content">
    <% if @is_active %>
      <%= render EstimationSessionUi::EstimateStepsComponent.new(estimate: @estimate) %>

      <div class="mt-4">
        <%= render EstimationSessionUi::ParameterSelectorComponent.new(
          estimate: @estimate,
          parameters: @parameters,
          is_facilitator: @is_facilitator
        ) %>

        <div id="<%= category.title.parameterize %>-parameter-display">
          <%= render EstimationSessionUi::ParameterDisplayComponent.new(
            estimate: @estimate
          ) %>
        </div>

        <p>Voting UI will be implemented in Phase 4-5</p>
      </div>
    <% end %>
  </div>
</div>
