<div class="<%= wrapper_classes %>">
  <%= content %>

  <%= @form.input :_destroy,
                  as: :hidden,
                  input_html: {
                    data: { nested_form_target: "destroy" }
                  } %>

  <button type="button"
          data-action="nested-form#remove"
          class="<%= remove_button_classes %>">
    <%= @remove_button_label %>
  </button>
</div>
