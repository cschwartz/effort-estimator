<li class="list-row participant-row" id="<%= dom_id(session_participant) %>">
  <%= render Display::AvatarComponent.new(
    user: session_participant.user,
    modifier: :placeholder,
    size: 8
  ) %>
  <span><%= session_participant.user.email %></span>
  <% if session_participant.is_facilitator? %>
    <%= render Display::BadgeComponent.new(
      label: "Facilitator",
      variant: :primary,
      size: :sm
    ) %>
  <% end %>
</li>