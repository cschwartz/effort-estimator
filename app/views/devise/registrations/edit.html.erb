<%= render Authentication::CardComponent.new(
  title: "Edit #{resource_name.to_s.humanize}",
  subtitle: "Update your account details"
) do |component| %>
  <% component.with_link do %>
    <%= link_to "Back", :back, class: "link link-hover" %>
  <% end %>

  <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render Forms::FormErrorsComponent.new(resource) %>

    <%= f.input :email, required: true, autofocus: true %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="alert alert-info mb-4">
        <%= render IconComponent.new(name: :info, css_class: "stroke-current shrink-0") %>
        <span>Currently waiting confirmation for: <%= resource.unconfirmed_email %></span>
      </div>
    <% end %>

    <%= f.input :password,
                hint: "Leave blank if you don't want to change it",
                required: false,
                input_html: { autocomplete: "new-password" } %>
    <%= f.input :password_confirmation,
                required: false,
                input_html: { autocomplete: "new-password" } %>
    <%= f.input :current_password,
                hint: "We need your current password to confirm your changes",
                required: true,
                input_html: { autocomplete: "current-password" } %>

    <%= f.button :submit, "Update", class: "w-full" %>
  <% end %>

  <div class="divider"></div>

  <div class="text-center">
    <h3 class="text-lg font-semibold mb-2">Cancel my account</h3>
    <p class="text-sm text-base-content/70 mb-4">Unhappy with our service?</p>
    <%= button_to "Delete my account",
                  registration_path(resource_name),
                  data: { turbo_confirm: "Are you sure? This action cannot be undone." },
                  method: :delete,
                  class: "btn btn-error btn-outline" %>
  </div>
<% end %>
