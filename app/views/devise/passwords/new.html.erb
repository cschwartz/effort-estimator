<%= render Authentication::CardComponent.new(
  title: "Forgot your password?",
  subtitle: "Enter your email and we'll send you reset instructions"
) do |component| %>
  <%= render "devise/shared/links", component: component %>

  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render Forms::FormErrorsComponent.new(resource) %>

    <%= f.input :email,
                required: true,
                autofocus: true,
                input_html: { autocomplete: "email" } %>

    <%= f.button :submit, "Send reset instructions", class: "w-full" %>
  <% end %>
<% end %>
