<%= turbo_stream.replace "#{@current_estimate.category.title.parameterize}-steps" do %>
  <%= render EstimationSessionUi::EstimateStepsComponent.new(estimate: @current_estimate) %>
<% end %>
<%= turbo_stream.update "#{@current_estimate.category.title.parameterize}-parameter-selector", "" %>
<%= turbo_stream.replace "#{@current_estimate.category.title.parameterize}-parameter-display" do %>
  <%= render EstimationSessionUi::ParameterDisplayComponent.new(
    estimate: @current_estimate
  ) %>
<% end %>
<%= render_turbo_stream_flash_messages %>
