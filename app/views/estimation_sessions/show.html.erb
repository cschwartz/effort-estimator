<% if @is_facilitator %>
  <%= turbo_stream_from [ @estimation_session, :is_facilitator ] %>
<% end %>
<%= turbo_stream_from @estimation_session %>
<%= turbo_stream_from "session_participants" %>
<div id="estimation-session-page" class="min-h-screen">
  <!-- Session header -->
  <div id="session-header" class="mb-6">
    <%= render Layout::ShowViewComponent.new(
      record: @estimation_session,
      parent_resources: [@estimation_session.project],
      singular_resources: [EstimationSession],
      actions: [
        button_to(
          "Leave Session",
          project_estimation_session_session_participant_path(@estimation_session.project, "placeholder"),
          method: :delete,
          form: { data: { turbo_confirm: "Are you sure you want to leave?" } },
          class: "btn btn-warning btn-sm"
        )
      ]
    ) do %>
      <%= render Display::PropertyListComponent.new(wrapper: false) do |list| %>
        <% list.with_property_badge(
          label: "Status",
          value: @estimation_session.status.humanize,
          variant: case @estimation_session.status
                   when "active" then :success
                   when "completed" then :default
                   else :ghost
                   end
        ) %>
        <% list.with_property_text(
          label: "Estimation Option",
          value: @estimation_session.estimation_option.title
        ) %>
      <% end %>
    <% end %>
  </div>
  <!-- Main layout with sidebar on right -->
  <div class="flex gap-4">
    <!-- Main content area -->
    <div class="flex-1">
      <div id="current-effort-section">
        <% if @estimation_session.current_effort %>
          <%= render EstimationSessionUi::CurrentEffortComponent.new(
            effort: @estimation_session.current_effort
          ) %>
          <div id="categories-container">
            <% @current_effort_category_estimates.each do |estimate| %>
              <% is_active = !estimate.pending? %>
              <%= render EstimationSessionUi::CategoryCollapseComponent.new(
                estimate: estimate,
                is_active: is_active,
                is_facilitator: @estimation_session.facilitator == current_user,
                parameters: @project_parameters
              ) %>
            <% end %>
          </div>
        <% else %>
          <div class="alert alert-warning">
            <span>No efforts available for estimation</span>
          </div>
        <% end %>
      </div>
    </div>
    <!-- Sidebar with participants -->
    <div class="w-120 flex-shrink-0">
      <div id="participants-sidebar">
        <%= render EstimationSessionUi::ParticipantListComponent.new(
          participants: @active_participants,
          facilitator: @estimation_session.facilitator
        ) %>
      </div>
    </div>
  </div>
</div>
